# EpochShell theme: gruvbox-hard
#
# gruvbox on bg0_h, its hard-contrast ground. Nothing else changes, and nothing else should: in
# gruvbox "hard", "medium" and "soft" name a background and only a background. The palette is the
# same one.
#
# Leaving the ramp where it is, is the point rather than an oversight. Dropping the ground while the
# surfaces stay put widens every step against it -- surface 1.27 to 1.41, text 10.8 to 12.0, the
# accent 5.5 to 6.1. That extra separation *is* the hard contrast; matching the medium ratios back
# up, the way dark-deep does, would undo the thing being asked for.

extends = "gruvbox"

background = "#1d2021"
